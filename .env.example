# ==============================================================================
# WORLDPULSE - ENVIRONMENT CONFIGURATION
# ==============================================================================
# WorldPulse connects out of the box to live international Google News RSS feeds
# and BBC World wire feeds with ZERO required API keys and NO usage fees.
#
# If you wish to supplement or connect alternative third-party news APIs,
# configure the optional variables below:
# ==============================================================================

# Port configuration (default: 5173)
PORT=5173

# Optional: GNews.io API Key (Free tier allows 100 requests/day)
# https://gnews.io/
VITE_GNEWS_API_KEY=

# Optional: NewsData.io API Key (Free tier allows 200 credits/day)
# https://newsdata.io/
VITE_NEWSDATA_API_KEY=

# Optional: NewsAPI.org API Key (Free tier allows 100 requests/day, developer use)
# https://newsapi.org/
NEWS_API_KEY=

# Default Edition ('global' | 'india' | 'us' | 'uk')
VITE_DEFAULT_EDITION=global
