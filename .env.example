# Bhandara Finder Environment Configuration

# 1. Supabase PostgreSQL & Auth Configuration
# Create a free project at https://supabase.com
# Execute the SQL script in `supabase/schema.sql` in your Supabase SQL Editor
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-api-key"

# 2. Server Port (Default: 3000)
PORT=3000

# 3. Target Environment (development | production)
NODE_ENV=development
